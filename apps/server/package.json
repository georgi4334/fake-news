{
  "name": "@veritas/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/queue/worker.ts",
    "build": "tsup src/index.ts src/queue/worker.ts --format esm --target node20 --out-dir dist --noExternal @veritas/shared",
    "start": "node dist/index.js",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@contentauth/c2pa-node": "^0.11.0",
    "@mozilla/readability": "^0.6.0",
    "@prisma/client": "^6.19.3",
    "@veritas/shared": "*",
    "bullmq": "^6.7.6",
    "cors": "^2.8.6",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsdom": "^31.0.1",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
