# Claude (optional: without it, analyzers fall back to local heuristics)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Google Fact Check Tools API (optional, free): published fact-checks for each claim
GOOGLE_FACTCHECK_API_KEY=
# Fact-check cost controls: web searches are billed per search
# FACTCHECK_MAX_CLAIMS=6
# FACTCHECK_MAX_SEARCHES=8

# Google Cloud Vision (optional): reverse image search ("web detection"); free tier ~1,000 images/month
GOOGLE_VISION_API_KEY=
# MAX_ARTICLE_IMAGES=4

# Postgres (optional: without it, an in-memory store is used)
DATABASE_URL=postgresql://veritas:veritas@localhost:5432/veritas

# Redis (optional: without it, analyses run inside the API process; with it, run `npm run worker`)
REDIS_URL=redis://localhost:6379

PORT=4000
CORS_ORIGIN=http://localhost:5173
